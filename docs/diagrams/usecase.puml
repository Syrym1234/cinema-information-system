@startuml usecase
left to right direction
skinparam packageStyle rectangle
actor "Пайдаланушы" as User
actor "Көрермен" as Customer
actor "Кассир" as Cashier
actor "Билет тексеруші" as Controller
actor "Бар қызметкері" as Bar
actor "Контент-менеджер" as Content
actor "Әкімші" as Admin
actor "Директор" as Director
actor "Төлем жүйесі" as Pay <<external>>

Customer --|> User
Cashier --|> User
Controller --|> User
Bar --|> User
Content --|> User
Admin --|> User
Director --|> User

rectangle "Кинотеатрдың ақпараттық жүйесі" {
  usecase "UC-01\nЖүйеге кіру / тіркелу" as UC01
  usecase "UC-02\nАфишаны қарау және сеанс іздеу" as UC02
  usecase "UC-03\nОрын таңдау және брондау" as UC03
  usecase "UC-04\nОнлайн билет сатып алу" as UC04
  usecase "UC-05\nТоптық брондау" as UC05
  usecase "UC-06\nТағамға алдын ала тапсырыс" as UC06
  usecase "UC-07\nКассада билет сату" as UC07
  usecase "UC-08\nБилетті қайтару" as UC08
  usecase "UC-09\nБилетті тексеру" as UC09
  usecase "UC-10\nТағам тапсырысын беру" as UC10
  usecase "UC-11\nРепертуар мен афишаны басқару" as UC11
  usecase "UC-12\nСеанстар кестесін құру" as UC12
  usecase "UC-13\nПайдаланушыларды басқару" as UC13
  usecase "UC-14\nЕсептерді қарау" as UC14
}

User --> UC01
User --> UC02
Customer --> UC03
Customer --> UC04
Customer --> UC05
Customer --> UC06
Cashier --> UC07
Cashier --> UC08
Controller --> UC09
Bar --> UC10
Content --> UC11
Admin --> UC12
Admin --> UC13
Admin --> UC14
Director --> UC14
UC04 --> Pay

UC04 ..> UC03 : <<include>>
UC05 ..> UC03 : <<extend>>
UC06 ..> UC04 : <<extend>>
@enduml
